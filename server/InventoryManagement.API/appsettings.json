{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/InventoryManagement-.txt",
          "rollingInterval": "Hour",
          "retainedFileCountLimit": 168,
          "fileSizeLimitBytes": 10485760,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=inventory.db"
  },
  "Jwt": {
    "KeySource": "Inline",
    "Key": "",
    "KeySecretName": "",
    "Issuer": "InventoryManagement.API",
    "Audience": "InventoryManagement.Client",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 0
  },
  "Idempotency": {
    "MaxKeyLength": 100,
    "MaxCacheableBodyBytes": 262144,
    "LockDuration": "00:05:00",
    "Retention": "1.00:00:00",
    "CleanupInterval": "00:30:00",
    "CleanupBatchSize": 500,
    "ExcludedPathPrefixes": [ "/api/auth" ]
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": true
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "SeedData": {
    "AdminEmail": "admin@inventorymanagement.com",
    "AdminPassword": ""
  },
  "AllowedHosts": "*"
}
